@startuml Bootsverleih Klassendiagramm

skinparam classAttributeIconSize 0
skinparam linetype ortho

' ==========================================
' ENUMS
' ==========================================
package "Enums" {
    enum Availability {
        VERFUEGBAR = 1
        RESERVIERT = 2
        VERMIETET = 3
        NICHT_VERFUEGBAR = 4
        WARTUNG = 5
        AUSSER_BETRIEB = 6
        --
        +list(): array
    }

    enum BoatTyoe {
        SEGELBOOT = 1
        MOTORBOOT = 2
        KAJAK = 3
        KANU = 4
        SUP = 5
        --
        +list(): array
    }

    enum OrderStatus {
        BESTAETIGT = 1
        ABGESCHLOSSEN = 2
        STORNIERT = 3
        IN_BEARBEITUNG = 4
        --
        +list(): array
    }

    enum PaymentStatus {
        AUSSTEHEND = 1
        BEZAHLT = 2
        TEILWEISE_BEZAHLT = 3
        FEHLGESCHLAGEN = 4
        STORNIERT = 5
        RUECKERSTATTET = 6
        --
        +list(): array
    }

    enum PaymentMethod {
        UEBERWEISUNG = 1
        LASTSCHRIFT = 2
        BAR = 3
        KREDITKARTE = 4
        --
        +list(): array
    }

    enum PaymentRhythm {
        EINMALIG = 1
        MONATLICH = 2
        JAEHRLICH = 3
        --
        +list(): array
    }
}

' ==========================================
' MODEL CLASSES
' ==========================================
package "Models" {
    abstract class DatabaseEntry {
        #id: int|null
        #active: bool
        #created_at: string|null
        #updated_at: string|null
        #user: User|int|null
        --
        +__construct(id, active, created_at, updated_at, user)
        #saveData(stmt: PDOStatement, pdo: PDO): void
        +{static} saveRelations(pdo, table, col1, col2, id, ids): void
        +{static} deactivateByID(pdo: PDO, id: int): void
        +{static} deleteByID(pdo: PDO, id: int): void
        +deleteEntry(pdo: PDO): void
        +getID(): int|null
        +setID(id: int): void
        +getActive(): bool
        +setActive(active: bool): void
        +getCreated_at(): string
        +setCreated_at(created_at: string): void
        +getUpdated_at(): string
        +setUpdated_at(updated_at: string): void
        +getUser(): User|int|null
        +setUser(user: User|int|null): void
        --
        +{abstract} {static} getTable(): string
        #{abstract} {static} getInsertStmnt(): string
        #{abstract} {static} getUpdateStmnt(): string
        +{abstract} saveEntry(pdo: PDO): void
        +{abstract} {static} findByIdEntry(pdo, id): self|null
        +{abstract} {static} findAllEntries(pdo, filter): array
        +{abstract} toArray(): array
    }

    abstract class Person extends DatabaseEntry {
        #vorname: string
        #nachname: string
        #email: string
        #geburtsdatum: string
        #telefon: string
        #strasse: string
        #plz: int
        #stadt: string
        --
        +__construct(vorname, nachname, email, geburtsdatum, telefon, strasse, plz, stadt, ...)
        #savePerson(stmt: PDOStatement, pdo: PDO): void
        #toPersonArray(): array
        +getVorname(): string
        +setVorname(vorname: string): void
        +getNachname(): string
        +setNachname(nachname: string): void
        +getEmail(): string
        +setEmail(email: string): void
        +getGeburtsdatum(): string
        +setGeburtsdatum(geburtsdatum: string): void
        +getTelefon(): string
        +setTelefon(telefon: string): void
        +getStrasse(): string
        +setStrasse(strasse: string): void
        +getPlz(): int
        +setPlz(plz: int): void
        +getStadt(): string
        +setStadt(stadt: string): void
        +getFullName(): string
    }

    class User extends DatabaseEntry {
        -username: string
        -passwordHash: string
        -kunde: int|null
        -mitarbeiter: int|null
        --
        +__construct(username, passwordHash, kunde, mitarbeiter, ...)
        +{static} getTable(): string
        +verifyPassword(password: string): bool
        +saveEntry(pdo: PDO): void
        +deleteEntry(pdo: PDO): void
        +{static} findByIdEntry(pdo, id): self|null
        +{static} findForAuth(pdo, username): User|null
        +{static} findAllEntries(pdo, filter): array
        +toArray(): array
        +getUsername(): string
        +setUsername(username: string): void
        +getPasswordHash(): string
        +setPasswordHash(hash: string): void
        +getKunde(): Kunde|int|null
        +setKunde(kunde: Kunde|int|null): void
        +getMitarbeiter(): Mitarbeiter|int|null
        +setMitarbeiter(ma: Mitarbeiter|int|null): void
    }

    class Kunde extends Person {
        -bestellungen: array
        -zahlungen: array
        -vertraege: array
        --
        +__construct(vorname, nachname, email, ...)
        +{static} getTable(): string
        +saveEntry(pdo: PDO): void
        +{static} findByIdEntry(pdo, id): self|null
        +{static} findAllEntries(pdo, filter): array
        +toArray(): array
        +getBestellungen(): array
        +setBestellungen(bestellungen: array): void
        +getVertraege(): array
        +setVertraege(vertraege: array): void
        +getZahlungen(): array
        +setZahlungen(zahlungen: array): void
    }

    class Mitarbeiter extends Person {
        --
        +__construct(vorname, nachname, email, ...)
        +{static} getTable(): string
        +saveEntry(pdo: PDO): void
        +{static} findByIdEntry(pdo, id): self|null
        +{static} findAllEntries(pdo, filter): array
        +toArray(): array
    }

    class Boot extends DatabaseEntry {
        -laenge: float
        -breite: float
        -tiefgang: float
        -beschreibung: string
        -kapazitaet: int
        -bootstyp: BoatTyoe|int
        -preis_pro_tag: float
        -kaution: float
        -verfuegbarkeit: Availability|int
        -features: array
        --
        +__construct(laenge, breite, tiefgang, ...)
        +{static} getTable(): string
        +saveEntry(pdo: PDO): void
        +saveBootFeatureRelations(pdo: PDO): void
        +{static} findByIdEntry(pdo, id): self|null
        +{static} findAllEntries(pdo, filter): array
        +toArray(): array
        +getLaenge(): float
        +setLaenge(laenge: float): void
        +getBreite(): float
        +setBreite(breite: float): void
        +getTiefgang(): float
        +setTiefgang(tiefgang: float): void
        +getBeschreibung(): string
        +setBeschreibung(beschreibung: string): void
        +getKapazitaet(): int
        +setKapazitaet(kapazitaet: int): void
        +getBootstyp(): BoatTyoe|int
        +setBootstyp(bootstyp: BoatTyoe|int): void
        +getPreis_pro_tag(): float
        +setPreis_pro_tag(preis: float): void
        +getKaution(): float
        +setKaution(kaution: float): void
        +getVerfuegbarkeit(): Availability|int
        +setVerfuegbarkeit(v: Availability|int): void
        +getFeatures(): array
        +setFeatures(features: array): void
    }

    class Feature extends DatabaseEntry {
        -bezeichnung: string|null
        -beschreibung: string|null
        --
        +__construct(bezeichnung, beschreibung, ...)
        +{static} getTable(): string
        +saveEntry(pdo: PDO): void
        +{static} findByIdEntry(pdo, id): self|null
        +{static} findAllEntries(pdo, filter): array
        +toArray(): array
        +getBezeichnung(): string|null
        +setBezeichnung(bezeichnung: string|null): void
        +getBeschreibung(): string|null
        +setBeschreibung(beschreibung: string|null): void
    }

    class Bestellung extends DatabaseEntry {
        -kunde: Kunde|int
        -bestellstatus: OrderStatus|int
        --
        +__construct(kunde, bestellstatus, ...)
        +{static} getTable(): string
        +saveEntry(pdo: PDO): void
        +{static} findByIdEntry(pdo, id): self|null
        +{static} findAllEntries(pdo, filter): array
        +toArray(): array
        +getKunde(): Kunde|int
        +setKunde(kunde: Kunde|int): void
        +getBestellstatus(): OrderStatus|int
        +setBestellstatus(status: OrderStatus|int): void
    }

    class BootMiete extends DatabaseEntry {
        -boot: int
        -bestellung: int
        -startdatum: string
        -enddatum: string
        -preisProTag: float
        --
        +__construct(boot, bestellung, startdatum, enddatum, preisProTag, ...)
        +{static} getTable(): string
        +{static} findAllEntries(pdo, filter): array
        +getBestellungId(): int
        +toArray(): array
    }

    class Vertrag extends DatabaseEntry {
        -bestellung: int
        -zahlungsrhythmus: PaymentRhythm|int
        -zahlungsmethode: PaymentMethod|int
        -vertragsbeginn: string|null
        -gekuendigtAm: string|null
        --
        +__construct(bestellung, zahlungsrhythmus, zahlungsmethode, ...)
        +{static} getTable(): string
        +saveEntry(pdo: PDO): void
        +{static} findAllEntries(pdo, filter): array
        +getBestellung(): int
        +toArray(): array
    }

    class Zahlung extends DatabaseEntry {
        -vertrag: Vertrag|int
        -zahlungsstatus: PaymentStatus|int
        -betrag: float
        -faelligAm: string|null
        -bezahltAm: string|null
        --
        +__construct(vertrag, zahlungsstatus, betrag, ...)
        +{static} getTable(): string
        +{static} findAllEntries(pdo, filter): array
        +getVertrag(): Vertrag|int
        +toArray(): array
    }

    class Liegeplatz extends DatabaseEntry {
        -beschreibung: string
        -bezeichnung: string|null
        -preisProTag: float|null
        -kapazitaet: int|null
        -posX: float
        -posY: float
        -posW: float
        -posH: float
        -reservierungen: array
        --
        +__construct(beschreibung, bezeichnung, preisProTag, ...)
        +{static} getTable(): string
        +saveEntry(pdo: PDO): void
        +{static} findByIdEntry(pdo, id): self|null
        +{static} findAllEntries(pdo, filter): array
        +toArray(): array
        +getBeschreibung(): string
        +setBeschreibung(beschreibung: string): void
        +getBezeichnung(): string|null
        +setBezeichnung(bezeichnung: string|null): void
        +getPreisProTag(): float|null
        +setPreisProTag(preis: float|null): void
        +getKapazitaet(): int|null
        +setKapazitaet(kapazitaet: int|null): void
        +getPosX(): float
        +getPosY(): float
        +getPosW(): float
        +getPosH(): float
        +getReservierungen(): array
        +setReservierungen(reservierungen: array): void
    }

    class LiegeplatzReservierung extends DatabaseEntry {
        -liegeplatz: Liegeplatz|int
        -boot: int
        -bestellung: int
        -startdatum: string
        -enddatum: string
        -preisProTag: float
        -status: int
        -expires_at: string
        -confirmed_at: string|null
        -confirm_token: string
        --
        +__construct(liegeplatz, boot, bestellung, ...)
        +{static} getTable(): string
        +saveEntry(pdo: PDO): void
        +{static} findAllEntries(pdo, filter): array
        +{static} findByToken(pdo, token): self|null
        +getBestellungId(): int
        +toArray(): array
    }

    class DBConnection {
        -{static} pdo: PDO|null
        -{static} env: array
        --
        -__construct()
        -{static} loadEnv(): void
        +{static} getConnection(): PDO
    }

    class ReservationEmail {
        -{static} FROM_EMAIL: string
        -{static} FROM_NAME: string
        --
        +{static} sendConfirmation(kunde: Kunde, token: string, expires: string): bool
    }
}

' ==========================================
' CONTROLLER CLASSES
' ==========================================
package "Controllers" {
    abstract class BaseController {
        #request: CLIRequest|IncomingRequest
        #helpers: array
        --
        +initController(request, response, logger): void
    }

    class Home extends BaseController {
        +index(): string
        +settings(): string
        +support(): string
        +zahlungen(): string
        +kundenverwaltung(): string
        +bootsverleih(): string
        +liegeplaetze(): string
        +accountSettings(): string
    }

    class AuthController extends BaseController {
        +index()
        +login()
        +register()
        +logout()
        +loadUser()
    }

    class BootsverleihController extends BaseController {
        +index()
        +loadBoote()
        +loadFeatures()
        +saveBoot()
        +deleteBoot()
    }

    class KundenverwaltungController extends BaseController {
        +index()
        +loadKundenverwaltung()
        +saveKundenverwaltung()
        +deleteKundenverwaltung()
    }

    class LiegeplatzeController extends BaseController {
        +index()
        +loadLiegeplaetze()
        +saveReservierung()
        +confirm(token: string)
        +confirmPost()
    }

    class ZahlungenController extends BaseController {
        +index()
        +loadZahlungsVerwaltung()
        +loadZahlungem()
        +loadBestellungen()
        +loadVertaege()
    }

    class AccountEinstellungenController extends BaseController {
        +loadAccountData()
        +savePersonalData()
        +changeUsername()
        +changePassword()
    }

    class MetaController extends BaseController {
        +index()
        +loadEnums()
    }
}

' ==========================================
' RELATIONSHIPS
' ==========================================

' User relationships
User "0..1" -- "0..1" Kunde : hat >
User "0..1" -- "0..1" Mitarbeiter : hat >

' Kunde relationships
Kunde "1" -- "*" Bestellung : erstellt >
Kunde "1" -- "*" Vertrag : hat >
Kunde "1" -- "*" Zahlung : leistet >

' Boot relationships
Boot "*" -- "*" Feature : hat >
Boot ..> BoatTyoe : verwendet
Boot ..> Availability : verwendet

' Bestellung relationships
Bestellung "*" -- "1" Kunde : gehoert zu >
Bestellung ..> OrderStatus : verwendet

' BootMiete relationships
BootMiete "*" -- "1" Boot : betrifft >
BootMiete "*" -- "1" Bestellung : gehoert zu >

' Vertrag relationships
Vertrag "*" -- "1" Bestellung : basiert auf >
Vertrag ..> PaymentRhythm : verwendet
Vertrag ..> PaymentMethod : verwendet

' Zahlung relationships
Zahlung "*" -- "1" Vertrag : gehoert zu >
Zahlung ..> PaymentStatus : verwendet

' Liegeplatz relationships
Liegeplatz "1" -- "*" LiegeplatzReservierung : hat >

' LiegeplatzReservierung relationships
LiegeplatzReservierung "*" -- "1" Boot : fuer >
LiegeplatzReservierung "*" -- "1" Bestellung : gehoert zu >
LiegeplatzReservierung "*" -- "1" Liegeplatz : an >

' Controller dependencies (hidden for cleaner diagram)
AuthController ..> User : verwendet
AuthController ..> Kunde : verwendet
BootsverleihController ..> Boot : verwendet
BootsverleihController ..> Feature : verwendet
KundenverwaltungController ..> Kunde : verwendet
LiegeplatzeController ..> Liegeplatz : verwendet
LiegeplatzeController ..> LiegeplatzReservierung : verwendet
LiegeplatzeController ..> Bestellung : verwendet
ZahlungenController ..> Zahlung : verwendet
ZahlungenController ..> Vertrag : verwendet
ZahlungenController ..> Bestellung : verwendet
AccountEinstellungenController ..> User : verwendet
AccountEinstellungenController ..> Kunde : verwendet
MetaController ..> Availability : verwendet
MetaController ..> BoatTyoe : verwendet
MetaController ..> OrderStatus : verwendet
MetaController ..> PaymentStatus : verwendet
MetaController ..> PaymentMethod : verwendet
MetaController ..> PaymentRhythm : verwendet

ReservationEmail ..> Kunde : verwendet

@enduml
